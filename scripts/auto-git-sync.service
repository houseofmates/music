[Unit]
Description=git auto-sync for music
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.hermes/scripts/git-pull-sync.sh %h/projects/music
Restart=always
RestartSec=5
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=%h

[Install]
WantedBy=default.target
