[Unit]
Description=Auto-commit system for music app
After=network.target

[Service]
Type=simple
User=%U
WorkingDirectory=%h/projects/music/backend
ExecStart=/usr/bin/python3 %h/projects/music/backend/auto_commit.py
Restart=always
RestartSec=10
Environment=PYTHONPATH=%h/projects/music/backend

[Install]
WantedBy=multi-user.target